@model IEnumerable<K23CNT3_VuTienDuc_BaiTX1.Models.VtdCategory>

@{
    ViewData["Title"] = "Danh sách Thể loại";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-tags me-2 text-primary"></i>Danh sách Thể loại</h2>
        <p class="text-muted mb-0">Quản lý các thể loại sách</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Thêm mới
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">@Html.DisplayNameFor(model => model.VtdCategoryName)</th>
                    <th class="text-end pe-3">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="2" class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                            Chưa có thể loại nào.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-semibold">
                                <i class="bi bi-bookmark me-2 text-secondary"></i>@Html.DisplayFor(modelItem => item.VtdCategoryName)
                            </td>
                            <td class="text-end pe-3">
                                <a asp-action="Details" asp-route-id="@item.VtdCategoryId" class="btn btn-sm btn-outline-secondary" title="Chi tiết">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.VtdCategoryId" class="btn btn-sm btn-outline-warning" title="Sửa">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.VtdCategoryId" class="btn btn-sm btn-outline-danger" title="Xóa">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
