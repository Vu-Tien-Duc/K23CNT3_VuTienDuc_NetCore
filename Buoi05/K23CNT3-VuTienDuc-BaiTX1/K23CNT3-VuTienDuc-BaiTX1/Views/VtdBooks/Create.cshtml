@model K23CNT3_VuTienDuc_BaiTX1.Models.VtdBook
@{
    ViewData["Title"] = "Thêm sách";
}

<div class="mb-4">
    <h2 class="fw-bold mb-1"><i class="bi bi-journal-plus me-2 text-primary"></i>Thêm sách mới</h2>
    <p class="text-muted mb-0">Nhập thông tin đầu sách</p>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="VtdBookId" class="form-label fw-semibold"></label>
                    <input asp-for="VtdBookId" class="form-control" placeholder="Nhập mã sách" />
                    <span asp-validation-for="VtdBookId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="VtdTitle" class="form-label fw-semibold"></label>
                    <input asp-for="VtdTitle" class="form-control" placeholder="Tên sách" />
                    <span asp-validation-for="VtdTitle" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="VtdAuthor" class="form-label fw-semibold"></label>
                    <input asp-for="VtdAuthor" class="form-control" placeholder="Tác giả" />
                    <span asp-validation-for="VtdAuthor" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="VtdRelease" class="form-label fw-semibold"></label>
                    <input asp-for="VtdRelease" type="type" class="form-control" placeholder="Năm"/>
                    
                    <span asp-validation-for="VtdRelease" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="VtdPrice" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <input asp-for="VtdPrice" type="number" step="1000" min="0" class="form-control" placeholder="0" />
                        <span class="input-group-text">đ</span>
                    </div>
                    <span asp-validation-for="VtdPrice" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="VtdDescription" class="form-label fw-semibold"></label>
                    <textarea asp-for="VtdDescription" class="form-control" rows="3" placeholder="Mô tả ngắn về nội dung sách"></textarea>
                    <span asp-validation-for="VtdDescription" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold"><i class="bi bi-image me-1"></i>Ảnh bìa</label>
                    <input type="file" name="anhBia" class="form-control" accept="image/*" />
                    <div class="form-text">Chọn ảnh bìa JPG/PNG cho sách (không bắt buộc).</div>
                </div>

                <div class="col-md-3">
                    <label asp-for="VtdPublisherId" class="form-label fw-semibold"></label>
                    <select asp-for="VtdPublisherId" class="form-select" asp-items="ViewBag.VtdPublisherId">
                        <option value="">-- Chọn nhà xuất bản --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="VtdCategoryId" class="form-label fw-semibold"></label>
                    <select asp-for="VtdCategoryId" class="form-select" asp-items="ViewBag.VtdCategoryId">
                        <option value="">-- Chọn thể loại --</option>
                    </select>
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-check-circle me-1"></i> Tạo mới
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
