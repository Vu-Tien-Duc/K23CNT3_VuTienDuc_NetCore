@model K23CNT3_VuTienDuc_BaiTX1.Models.VtdBook
@{
    ViewData["Title"] = "Chi tiết sách";
    var imgSrc = "";
    if (!string.IsNullOrEmpty(Model?.VtdPicture))
    {
        imgSrc = (Model.VtdPicture.StartsWith("http") || Model.VtdPicture.StartsWith("/"))
            ? Model.VtdPicture
            : Url.Content("~/images/book/" + Model.VtdPicture);
    }
}

<div class="mb-4">
    <h2 class="fw-bold mb-1"><i class="bi bi-book me-2 text-primary"></i>Chi tiết sách</h2>
    <p class="text-muted mb-0">Thông tin đầy đủ về đầu sách</p>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <div class="row g-4">
            <div class="col-md-3 text-center">
                @if (!string.IsNullOrEmpty(imgSrc))
                {
                    <img src="@imgSrc" alt="@Model.VtdTitle" class="rounded shadow-sm" style="width:100%;max-width:180px;aspect-ratio:3/4;object-fit:cover;" />
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center bg-light rounded text-muted mx-auto" style="width:180px;height:240px;">
                        <i class="bi bi-image fs-1"></i>
                    </div>
                }
            </div>
            <div class="col-md-9">
                <h4 class="fw-bold mb-1">@Html.DisplayFor(model => model.VtdTitle)</h4>
                <p class="text-muted mb-3"><i class="bi bi-person-badge me-1"></i>@Html.DisplayFor(model => model.VtdAuthor)</p>

                <dl class="row mb-0">
                    <dt class="col-sm-3 text-muted fw-normal">@Html.DisplayNameFor(model => model.VtdRelease)</dt>
                    <dd class="col-sm-9">@Model.VtdRelease?.ToString("dd/MM/yyyy")</dd>

                    <dt class="col-sm-3 text-muted fw-normal">@Html.DisplayNameFor(model => model.VtdPrice)</dt>
                    <dd class="col-sm-9 fw-bold text-success">@Model.VtdPrice?.ToString("N0") đ</dd>

                    <dt class="col-sm-3 text-muted fw-normal">Thể loại</dt>
                    <dd class="col-sm-9"><span class="badge bg-light text-dark border">@Html.DisplayFor(model => model.VtdCategory.VtdCategoryName)</span></dd>

                    <dt class="col-sm-3 text-muted fw-normal">Nhà xuất bản</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.VtdPublisher.VtdPublisherName)</dd>

                    <dt class="col-sm-3 text-muted fw-normal">@Html.DisplayNameFor(model => model.VtdDescription)</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.VtdDescription)</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="mt-3 d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model?.VtdBookId" class="btn btn-warning">
        <i class="bi bi-pencil me-1"></i> Sửa
    </a>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
    </a>
</div>
