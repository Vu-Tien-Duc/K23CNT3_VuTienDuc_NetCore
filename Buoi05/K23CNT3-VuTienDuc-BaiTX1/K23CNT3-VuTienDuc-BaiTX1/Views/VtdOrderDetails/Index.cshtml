@model IEnumerable<K23CNT3_VuTienDuc_BaiTX1.Models.VtdOrderDetail>

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-list-check me-2 text-primary"></i>Chi tiết đơn hàng</h2>
        <p class="text-muted mb-0">Danh sách các mục sản phẩm trong đơn hàng</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Thêm mới
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3"><i class="bi bi-book me-1"></i>Sách</th>
                    <th>Đơn hàng</th>
                    <th class="text-center">@Html.DisplayNameFor(model => model.VtdQuantity)</th>
                    <th class="text-end">@Html.DisplayNameFor(model => model.VtdPrice)</th>
                    <th class="text-end">@Html.DisplayNameFor(model => model.VtdTotalMoney)</th>
                    <th class="text-end pe-3">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                            Chưa có chi tiết đơn hàng nào.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-semibold">@Html.DisplayFor(modelItem => item.VtdBook.VtdTitle)</td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    #@item.VtdOrder.VtdOrderId - @item.VtdOrder.VtdOrderDate?.ToString("dd/MM/yyyy")
                                </span>
                            </td>
                            <td class="text-center">@Html.DisplayFor(modelItem => item.VtdQuantity)</td>
                            <td class="text-end">@item.VtdPrice?.ToString("N0") đ</td>
                            <td class="text-end fw-bold text-success">@item.VtdTotalMoney?.ToString("N0") đ</td>
                            <td class="text-end pe-3">
                                <a asp-action="Details" asp-route-id="@item.VtdOrderDetailId" class="btn btn-sm btn-outline-secondary" title="Chi tiết">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.VtdOrderDetailId" class="btn btn-sm btn-outline-warning" title="Sửa">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.VtdOrderDetailId" class="btn btn-sm btn-outline-danger" title="Xóa">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
