@model K23CNT3_VuTienDuc_BaiTX1.Models.VtdOrderDetail
@{
    ViewData["Title"] = "Chi tiết mục đơn hàng";
}

<div class="mb-4">
    <h2 class="fw-bold mb-1"><i class="bi bi-list-check me-2 text-primary"></i>Chi tiết mục đơn hàng</h2>
    <p class="text-muted mb-0">Thông tin chi tiết một mục sách trong đơn hàng</p>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <dl class="row mb-0">
            <dt class="col-sm-3 text-muted fw-normal"><i class="bi bi-book me-1"></i>Sách</dt>
            <dd class="col-sm-9 fw-semibold">@Html.DisplayFor(model => model.VtdBook.VtdTitle)</dd>

            <dt class="col-sm-3 text-muted fw-normal"><i class="bi bi-receipt me-1"></i>Đơn hàng</dt>
            <dd class="col-sm-9">
                <span class="badge bg-light text-dark border">
                    #@Model.VtdOrder.VtdOrderId - @Model.VtdOrder.VtdOrderDate?.ToString("dd/MM/yyyy")
                </span>
            </dd>

            <dt class="col-sm-3 text-muted fw-normal">@Html.DisplayNameFor(model => model.VtdQuantity)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.VtdQuantity)</dd>

            <dt class="col-sm-3 text-muted fw-normal">@Html.DisplayNameFor(model => model.VtdPrice)</dt>
            <dd class="col-sm-9">@Model.VtdPrice?.ToString("N0") đ</dd>

            <dt class="col-sm-3 text-muted fw-normal">@Html.DisplayNameFor(model => model.VtdTotalMoney)</dt>
            <dd class="col-sm-9 fw-bold text-success">@Model.VtdTotalMoney?.ToString("N0") đ</dd>
        </dl>
    </div>
</div>

<div class="mt-3 d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model?.VtdOrderDetailId" class="btn btn-warning">
        <i class="bi bi-pencil me-1"></i> Sửa
    </a>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
    </a>
</div>
