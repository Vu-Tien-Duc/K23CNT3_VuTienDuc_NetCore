@model K23CNT3_VuTienDuc_BaiTX1.Models.VtdOrderBook
@{
    ViewData["Title"] = "Thêm đơn hàng";
}

<div class="mb-4">
    <h2 class="fw-bold mb-1"><i class="bi bi-cart-plus me-2 text-primary"></i>Thêm đơn hàng mới</h2>
    <p class="text-muted mb-0">Nhập thông tin đơn đặt hàng</p>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="VtdOrderId" class="form-label fw-semibold"></label>
                    <input asp-for="VtdOrderId" class="form-control" placeholder="Nhập mã đơn hàng" />
                    <span asp-validation-for="VtdOrderId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="VtdAccountId" class="form-label fw-semibold"><i class="bi bi-person me-1"></i>Khách hàng</label>
                    <select asp-for="VtdAccountId" class="form-select" asp-items="ViewBag.VtdAccountId">
                        <option value="">-- Chọn khách hàng --</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label asp-for="VtdOrderDate" class="form-label fw-semibold"></label>
                    <input asp-for="VtdOrderDate" type="datetime-local" class="form-control" />
                    <span asp-validation-for="VtdOrderDate" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="VtdOrderReceive" class="form-label fw-semibold"></label>
                    <input asp-for="VtdOrderReceive" type="datetime-local" class="form-control" />
                    <span asp-validation-for="VtdOrderReceive" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="VtdReceiveAddress" class="form-label fw-semibold"></label>
                    <input asp-for="VtdReceiveAddress" class="form-control" placeholder="Địa chỉ nhận hàng" />
                    <span asp-validation-for="VtdReceiveAddress" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="VtdReceivePhone" class="form-label fw-semibold"></label>
                    <input asp-for="VtdReceivePhone" class="form-control" placeholder="Số điện thoại nhận hàng" />
                    <span asp-validation-for="VtdReceivePhone" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="VtdStatus" class="form-label fw-semibold"></label>
                    <select asp-for="VtdStatus" class="form-select">
                        <option value="">-- Chọn trạng thái --</option>
                        <option value="Chờ xác nhận">Chờ xác nhận</option>
                        <option value="Đang giao">Đang giao</option>
                        <option value="Hoàn thành">Hoàn thành</option>
                        <option value="Đã hủy">Đã hủy</option>
                    </select>
                    <div class="form-text">* Danh sách trạng thái này là gợi ý mẫu, chỉnh lại cho đúng giá trị thực tế bạn đang dùng trong DB nếu khác.</div>
                    <span asp-validation-for="VtdStatus" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="VtdNote" class="form-label fw-semibold"></label>
                    <input asp-for="VtdNote" class="form-control" placeholder="Ghi chú (nếu có)" />
                    <span asp-validation-for="VtdNote" class="text-danger small"></span>
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-check-circle me-1"></i> Tạo mới
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
