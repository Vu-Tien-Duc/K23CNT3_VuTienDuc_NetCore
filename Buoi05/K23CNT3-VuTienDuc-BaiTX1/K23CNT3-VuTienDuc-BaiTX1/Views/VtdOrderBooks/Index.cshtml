@model IEnumerable<K23CNT3_VuTienDuc_BaiTX1.Models.VtdOrderBook>

@{
    ViewData["Title"] = "Danh sách Đơn hàng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-cart-check me-2 text-primary"></i>Danh sách Đơn hàng</h2>
        <p class="text-muted mb-0">Quản lý các đơn đặt hàng của khách</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Thêm mới
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">@Html.DisplayNameFor(model => model.VtdOrderDate)</th>
                    <th><i class="bi bi-person me-1"></i>Khách hàng</th>
                    <th>@Html.DisplayNameFor(model => model.VtdReceiveAddress)</th>
                    <th>@Html.DisplayNameFor(model => model.VtdReceivePhone)</th>
                    <th>@Html.DisplayNameFor(model => model.VtdOrderReceive)</th>
                    <th>@Html.DisplayNameFor(model => model.VtdNote)</th>
                    <th class="text-center">@Html.DisplayNameFor(model => model.VtdStatus)</th>
                    <th class="text-end pe-3">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                            Chưa có đơn hàng nào.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3">@item.VtdOrderDate?.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="fw-semibold">@Html.DisplayFor(modelItem => item.VtdAccount.VtdFullName)</td>
                            <td>@Html.DisplayFor(modelItem => item.VtdReceiveAddress)</td>
                            <td>@Html.DisplayFor(modelItem => item.VtdReceivePhone)</td>
                            <td>@Html.DisplayFor(modelItem => item.VtdOrderReceive)</td>
                            <td>@Html.DisplayFor(modelItem => item.VtdNote)</td>
                            <td class="text-center">
                                @{
                                    var statusRaw = (item.VtdStatus ?? "").Trim();
                                    var statusClass = statusRaw.ToLower() switch
                                    {
                                        "chờ xác nhận" or "cho xac nhan" or "pending" => "bg-warning text-dark",
                                        "đang giao" or "dang giao" or "shipping" or "processing" => "bg-info text-dark",
                                        "hoàn thành" or "hoan thanh" or "completed" or "done" => "bg-success",
                                        "đã hủy" or "da huy" or "cancelled" or "canceled" => "bg-danger",
                                        "" => "bg-secondary",
                                        _ => "bg-secondary"
                                    };
                                    var statusText = string.IsNullOrEmpty(statusRaw) ? "Không xác định" : statusRaw;
                                }
                                <span class="badge @statusClass">@statusText</span>
                            </td>
                            <td class="text-end pe-3">
                                <a asp-action="Details" asp-route-id="@item.VtdOrderId" class="btn btn-sm btn-outline-secondary" title="Chi tiết">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.VtdOrderId" class="btn btn-sm btn-outline-warning" title="Sửa">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.VtdOrderId" class="btn btn-sm btn-outline-danger" title="Xóa">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<p class="text-muted small mt-2">
    <i class="bi bi-info-circle me-1"></i>
    Ghi chú: <code>VtdStatus</code> trong database là kiểu chuỗi (string), nên màu badge đang được map theo nội dung text (vd: "Chờ xác nhận", "Đang giao", "Hoàn thành", "Đã hủy"...). Nếu giá trị thực tế trong DB của bạn khác, hãy chỉnh lại các case trong khối <code>switch</code> cho khớp.
</p>
