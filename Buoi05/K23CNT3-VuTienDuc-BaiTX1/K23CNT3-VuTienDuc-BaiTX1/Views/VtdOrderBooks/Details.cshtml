@model K23CNT3_VuTienDuc_BaiTX1.Models.VtdOrderBook
@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    var statusRaw = (Model?.VtdStatus ?? "").Trim();
    var statusClass = statusRaw.ToLower() switch
    {
        "chờ xác nhận" or "cho xac nhan" or "pending" => "bg-warning text-dark",
        "đang giao" or "dang giao" or "shipping" or "processing" => "bg-info text-dark",
        "hoàn thành" or "hoan thanh" or "completed" or "done" => "bg-success",
        "đã hủy" or "da huy" or "cancelled" or "canceled" => "bg-danger",
        _ => "bg-secondary"
    };
    var statusText = string.IsNullOrEmpty(statusRaw) ? "Không xác định" : statusRaw;
}

<div class="mb-4">
    <h2 class="fw-bold mb-1"><i class="bi bi-cart-check me-2 text-primary"></i>Chi tiết đơn hàng</h2>
    <p class="text-muted mb-0">Thông tin đầy đủ của đơn hàng</p>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <div class="fw-bold fs-5"><i class="bi bi-person me-1"></i>@Html.DisplayFor(model => model.VtdAccount.VtdFullName)</div>
                <div class="text-muted small">@@@Html.DisplayFor(model => model.VtdAccount.VtdUsername)</div>
            </div>
            <span class="badge @statusClass fs-6">@statusText</span>
        </div>

        <dl class="row mb-0">
            <dt class="col-sm-3 text-muted fw-normal">@Html.DisplayNameFor(model => model.VtdOrderDate)</dt>
            <dd class="col-sm-9">@Model.VtdOrderDate?.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-3 text-muted fw-normal">@Html.DisplayNameFor(model => model.VtdOrderReceive)</dt>
            <dd class="col-sm-9">@Model.VtdOrderReceive?.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-3 text-muted fw-normal"><i class="bi bi-geo-alt me-1"></i>@Html.DisplayNameFor(model => model.VtdReceiveAddress)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.VtdReceiveAddress)</dd>

            <dt class="col-sm-3 text-muted fw-normal"><i class="bi bi-telephone me-1"></i>@Html.DisplayNameFor(model => model.VtdReceivePhone)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.VtdReceivePhone)</dd>

            <dt class="col-sm-3 text-muted fw-normal">@Html.DisplayNameFor(model => model.VtdNote)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.VtdNote)</dd>
        </dl>
    </div>
</div>

<div class="mt-3 d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model?.VtdOrderId" class="btn btn-warning">
        <i class="bi bi-pencil me-1"></i> Sửa
    </a>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
    </a>
</div>
