<div class="panel panel-primary" style="border-color: #cddc39;">
    <div class="panel-heading" style="background-color: #cddc39; color: #333; border-color: #cddc39;">
        <strong>Sản phẩm nổi bật</strong> (Load từ Component)
    </div>
    <div class="panel-body">
        <div class="row">
            <!-- Render 3 sản phẩm demo -->
            @for (int i = 0; i < 4; i++)
            {
                <div class="col-md-4 text-center">
                    <div class="thumbnail">
                
                        <img src="/images/lovisong3.jpg" alt="Lò vi sóng" style="max-width: 100%; height: auto;">
                        <div class="caption">
                   
                            <p style="font-size: 14px;">Lò vi sóng Nagakawa</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>