@model X.PagedList.IPagedList<VtdBuoi07Lab08.Models.VtdBlog>
@using X.PagedList.Mvc.Core;

@{
    ViewData["Title"] = "Index";
}

<h1>Quản lý Blog</h1>

<!-- Form Tìm kiếm -->
<form action="" method="get" class="form-inline mb-3">
    <div class="form-group">
        <label class="sr-only" for="keyword">Tìm theo tên blog</label>
        <input class="form-control" name="name" id="keyword" placeholder="Nhập tên cần tìm..." value="@ViewBag.keyword">
    </div>

    <button type="submit" class="btn btn-default mr-1">
        <i class="fas fa-search"></i>
    </button>

    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Thêm mới
    </a>
</form>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault().VtdName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault().VtdStatus)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault().VtdViewCount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault().VtdCreatedDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault().VtdImage)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FirstOrDefault().VtdDescription)
            </th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.VtdName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.VtdStatus)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.VtdViewCount)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.VtdCreatedDate)
                </td>
                <td>
                    <!-- Hiển thị Ảnh Blog -->
                    <img src="@item.VtdImage" alt="Blog Image" style="max-width: 100px; height: auto;" />
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.VtdDescription)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.VtdId" class="btn btn-sm btn-warning">Sửa</a> |
                    <a asp-action="Details" asp-route-id="@item.VtdId" class="btn btn-sm btn-info">Chi tiết</a> |
                    <a asp-action="Delete" asp-route-id="@item.VtdId" class="btn btn-sm btn-danger">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<hr />
<!-- Component Phân trang -->
@Html.PagedListPager(Model, page => Url.Action("Index", new { page = page, name = ViewBag.keyword }), new X.PagedList.Web.Common.PagedListRenderOptions
{
    LiElementClasses = new string[] { "page-item" },
    PageClasses = new string[] { "page-link" }
})