@model List<K23CNT3_VuTienDuc_2310900023.Models.VtdProduct>

@{
    ViewData["Title"] = "Danh sách Sản phẩm";

    // Lấy danh sách Category và ID danh mục hiện tại từ ViewBag (do Controller truyền sang)
    var categories = ViewBag.Categories as List<K23CNT3_VuTienDuc_2310900023.Models.VtdCategory>;
    int? currentCategoryId = ViewBag.CurrentCategoryId as int?;
}

<!-- Load Font chữ -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<!-- Load Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="container my-5 pt-3">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="VtdHome" asp-action="Index" class="text-decoration-none fw-semibold" style="color: var(--vtd-primary);">🏠 Trang chủ</a>
            </li>
            <li class="breadcrumb-item active fw-bold" aria-current="page">Tất cả sản phẩm</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- ================= CỘT TRÁI: TÌM KIẾM & DANH MỤC ================= -->
        <div class="col-lg-3">
            <div class="vtd-cat-panel h-auto position-sticky" style="top: 80px;">
                <div class="vtd-cat-panel-head mb-3">
                    <span class="vtd-eyebrow">Bộ lọc</span>
                    <h3>Danh mục sản phẩm</h3>
                </div>

                <!-- Form Tìm kiếm -->
                <form asp-controller="VtdHome" asp-action="Products" method="get" class="mb-4">
                    <div class="input-group shadow-sm" style="border-radius: 10px; overflow: hidden;">
                        <input type="text" name="searchString" class="form-control border-0 bg-light" placeholder="Tìm sản phẩm..." value="@ViewBag.SearchString" style="padding: 0.75rem 1rem;">
                        <!-- Giữ lại categoryId nếu đang lọc theo danh mục -->
                        @if (currentCategoryId != null)
                        {
                            <input type="hidden" name="categoryId" value="@currentCategoryId" />
                        }
                        <button type="submit" class="btn text-white px-3" style="background: var(--vtd-primary);">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </form>

                <!-- Danh sách Category -->
                <div class="vtd-cat-list">
                    <!-- Nút Tất cả sản phẩm -->
                    <a asp-controller="VtdHome" asp-action="Products" class="vtd-cat-row @(currentCategoryId == null ? "active-cat" : "")">
                        <span class="vtd-cat-thumb">
                            <i class="bi bi-grid-fill" style="color: var(--vtd-muted);"></i>
                        </span>
                        <span class="vtd-cat-name">Tất cả sản phẩm</span>
                    </a>

                    <!-- Render danh sách Category -->
                    @if (categories != null)
                    {
                        foreach (var cat in categories)
                        {
                            <a asp-controller="VtdHome" asp-action="Products" asp-route-categoryId="@cat.VtdId" class="vtd-cat-row @(currentCategoryId == cat.VtdId ? "active-cat" : "")">
                                <span class="vtd-cat-thumb">
                                    <img src="@cat.VtdImage" alt="@cat.VtdName">
                                </span>
                                <span class="vtd-cat-name">@cat.VtdName</span>
                            </a>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- ================= CỘT PHẢI: LƯỚI SẢN PHẨM ================= -->
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-end mb-4 pb-3 border-bottom">
                <h2 class="m-0" style="font-family: var(--font-display); font-size: 1.8rem; color: var(--vtd-primary-dark); font-weight: 800;">
                    @(ViewBag.SearchString != null ? $"Kết quả cho: '{ViewBag.SearchString}'" : "Sản phẩm của chúng tôi")
                </h2>
                <span class="badge" style="background: var(--vtd-primary-dark); font-size: 0.9rem; padding: 8px 12px; border-radius: 8px;">
                    @Model.Count() sản phẩm
                </span>
            </div>

            @if (Model != null && Model.Count > 0)
            {
                <div class="row row-cols-2 row-cols-md-3 g-3 g-lg-4">
                    @foreach (var item in Model)
                    {
                        <div class="col">
                            <div class="vtd-product-card">
                                <!-- Badge Giảm giá -->
                                @if (item.VtdSalePrice > 0 && item.VtdSalePrice < item.VtdPrice)
                                {
                                    var percentOff = item.VtdPrice > 0 ? (int)Math.Round(100 - (item.VtdSalePrice / item.VtdPrice * 100)) : 0;
                                    <span class="vtd-sale-tag">-@percentOff%</span>
                                }

                                <!-- Ảnh sản phẩm -->
                                <a asp-controller="VtdHome" asp-action="ProductDetail" asp-route-id="@item.VtdId" class="vtd-product-imgwrap">
                                    <img src="@item.VtdImage" alt="@item.VtdName">
                                </a>

                                <div class="vtd-product-body">
                                    <!-- Tên sản phẩm -->
                                    <a asp-controller="VtdHome" asp-action="ProductDetail" asp-route-id="@item.VtdId" class="vtd-product-name" title="@item.VtdName">
                                        @item.VtdName
                                    </a>

                                    <!-- Giá -->
                                    <div class="vtd-product-price">
                                        @if (item.VtdSalePrice > 0 && item.VtdSalePrice < item.VtdPrice)
                                        {
                                            <span class="vtd-price-now">@String.Format("{0:#,0} ₫", item.VtdSalePrice)</span>
                                            <span class="vtd-price-old">@String.Format("{0:#,0} ₫", item.VtdPrice)</span>
                                        }
                                        else
                                        {
                                            <span class="vtd-price-now">@String.Format("{0:#,0} ₫", item.VtdPrice)</span>
                                        }
                                    </div>

                                    <!-- Nút Xem chi tiết -->
                                    <a asp-controller="VtdHome" asp-action="ProductDetail" asp-route-id="@item.VtdId" class="vtd-add-btn">
                                        <span>Xem chi tiết</span>
                                        <span class="vtd-add-icon"><i class="bi bi-arrow-right"></i></span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- Thông báo không có sản phẩm -->
                <div class="vtd-empty p-5 d-flex flex-column align-items-center justify-content-center h-100">
                    <i class="bi bi-box-seam text-muted mb-3" style="font-size: 4rem; opacity: 0.5;"></i>
                    <h4 style="font-family: var(--font-display); color: var(--vtd-primary-dark);">Không tìm thấy sản phẩm nào!</h4>
                    <p class="text-muted mb-4">Vui lòng thử chọn danh mục khác hoặc nhập từ khóa tìm kiếm khác.</p>
                    <a asp-controller="VtdHome" asp-action="Products" class="btn text-white px-4 py-2 fw-semibold" style="background: var(--vtd-accent); border-radius: 10px;">
                        Xóa bộ lọc & Xem tất cả
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <style>
        /* ================= BIẾN MÀU CHỦ ĐẠO ================= */
        :root {
            --vtd-primary: #16463E;
            --vtd-primary-dark: #0C2B26;
            --vtd-accent: #E8763A;
            --vtd-bg: #F6F5F1;
            --vtd-surface: #FFFFFF;
            --vtd-text: #17201E;
            --vtd-muted: #6B7570;
            --vtd-border: #E4E2DB;
            --font-display: 'Sora', sans-serif;
            --font-body: 'Inter', sans-serif;
        }

        body {
            background-color: var(--vtd-bg);
            font-family: var(--font-body);
            color: var(--vtd-text);
        }

        .vtd-eyebrow {
            display: inline-block;
            font-size: .72rem;
            font-weight: 700;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: var(--vtd-accent);
            margin-bottom: .35rem;
        }

        /* ================= CỘT TRÁI: BỘ LỌC DANH MỤC ================= */
        .vtd-cat-panel {
            background: var(--vtd-surface);
            border-radius: 20px;
            padding: 1.5rem;
            box-shadow: 0 10px 30px rgba(12,43,38,.06);
        }
        .vtd-cat-panel-head h3 {
            font-size: 1.15rem;
            font-weight: 700;
            margin: 0;
            color: var(--vtd-primary-dark);
            font-family: var(--font-display);
        }
        .vtd-cat-list {
            display: flex;
            flex-direction: column;
            gap: .35rem;
        }
        .vtd-cat-row {
            display: flex;
            align-items: center;
            gap: .75rem;
            padding: .55rem .75rem;
            border-radius: 12px;
            text-decoration: none;
            color: var(--vtd-text);
            transition: all .2s ease;
        }
        .vtd-cat-row:hover {
            background: var(--vtd-bg);
            color: var(--vtd-primary);
            transform: translateX(4px);
        }
        /* Active State cho Danh mục đang chọn */
        .active-cat {
            background: rgba(22, 70, 62, 0.08) !important;
            color: var(--vtd-primary) !important;
            border-left: 4px solid var(--vtd-primary);
        }
        .active-cat .vtd-cat-name {
            font-weight: 700;
        }
        .vtd-cat-thumb {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            overflow: hidden;
            background: var(--vtd-bg);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
        .vtd-cat-thumb img { width: 100%; height: 100%; object-fit: cover; }
        .vtd-cat-name { flex: 1; font-weight: 600; font-size: .92rem; }

        /* ================= CỘT PHẢI: CARD SẢN PHẨM ================= */
        .vtd-product-card {
            background: var(--vtd-surface);
            border-radius: 16px;
            overflow: hidden;
            position: relative;
            box-shadow: 0 6px 18px rgba(12,43,38,.06);
            transition: transform .2s ease, box-shadow .2s ease;
            height: 100%;
            display: flex;
            flex-direction: column;
        }
        .vtd-product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 16px 30px rgba(12,43,38,.14);
        }
        .vtd-sale-tag {
            position: absolute;
            top: 12px; left: 12px; z-index: 2;
            background: var(--vtd-accent); color: #fff;
            font-size: .72rem; font-weight: 800;
            padding: 4px 9px; border-radius: 999px;
            box-shadow: 0 4px 10px rgba(232, 118, 58, 0.3);
        }
        .vtd-product-imgwrap {
            display: block; background: var(--vtd-surface);
            padding: 1.5rem; aspect-ratio: 1 / 1;
            border-bottom: 1px solid rgba(0,0,0,0.03);
        }
        .vtd-product-imgwrap img {
            width: 100%; height: 100%; object-fit: contain;
            transition: transform 0.3s ease;
        }
        .vtd-product-card:hover .vtd-product-imgwrap img {
            transform: scale(1.08);
        }
        .vtd-product-body {
            padding: 1.25rem; flex: 1;
            display: flex; flex-direction: column;
        }
        .vtd-product-name {
            font-weight: 600; font-size: .95rem; color: var(--vtd-text);
            text-decoration: none; display: -webkit-box;
            -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
            min-height: 2.8em; margin-bottom: .6rem;
            line-height: 1.4;
        }
        .vtd-product-name:hover { color: var(--vtd-primary); }
        .vtd-product-price { margin-top: auto; margin-bottom: 1rem; }
        .vtd-price-now { font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; color: var(--vtd-accent); }
        .vtd-price-old { font-size: .8rem; color: var(--vtd-muted); text-decoration: line-through; margin-left: .5rem; }

        /* Nút thao tác */
        .vtd-add-btn {
            display: flex; align-items: center; justify-content: space-between;
            background: var(--vtd-primary); color: #fff; text-decoration: none;
            font-weight: 600; font-size: .85rem; padding: .6rem 1rem;
            border-radius: 10px; transition: all .2s ease;
        }
        .vtd-add-btn:hover { background: var(--vtd-primary-dark); color: #fff; }
        .vtd-add-icon {
            width: 24px; height: 24px; border-radius: 50%;
            background: rgba(255,255,255,.2); display: flex;
            align-items: center; justify-content: center; font-size: .9rem;
        }

        /* Box trạng thái rỗng */
        .vtd-empty {
            background: var(--vtd-surface);
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(12,43,38,.04);
            min-height: 300px;
        }
    </style>
}