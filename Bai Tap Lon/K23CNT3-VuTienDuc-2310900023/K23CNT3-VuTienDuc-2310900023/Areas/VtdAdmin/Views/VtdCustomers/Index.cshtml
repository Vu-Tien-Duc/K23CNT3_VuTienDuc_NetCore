@model X.PagedList.IPagedList<K23CNT3_VuTienDuc_2310900023.Models.VtdCustomer>
@using X.PagedList.Mvc.Core;

@{
    ViewData["Title"] = "Quản lý Khách hàng";
}



<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="card card-outline card-primary shadow">

            <div class="card-header">
                <h3 class="card-title">
                    <a asp-action="Create" class="btn btn-primary btn-sm">
                        <i class="fas fa-plus"></i> Thêm Khách hàng
                    </a>
                </h3>

                <div class="card-tools mt-1">
                    <form action="" method="get">
                        <div class="input-group input-group-sm" style="width: 250px;">
                            <input type="text" name="name" class="form-control float-right" placeholder="Nhập tên khách hàng..." value="@ViewBag.keyword">
                            <div class="input-group-append">
                                <button type="submit" class="btn btn-default">
                                    <i class="fas fa-search"></i>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card-body table-responsive p-0">
                <table class="table table-hover table-striped text-nowrap align-middle">
                    <thead class="bg-light">
                        <tr>
                            <th class="text-center">@Html.DisplayNameFor(model => model.FirstOrDefault().VtdAvatar)</th>
                            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().VtdFullName)</th>
                            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().VtdEmail)</th>
                            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().VtdPhone)</th>
                            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().VtdGender)</th>
                            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().VtdBirthday)</th>
                            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().VtdAddress)</th>
                            <th class="text-center" style="width: 150px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="align-middle text-center p-2">
                                    <img src="@item.VtdAvatar" alt="Avatar" class="img-circle elevation-1 object-fit-cover" style="width: 45px; height: 45px;" />
                                </td>
                                <td class="align-middle fw-bold text-primary">
                                    @Html.DisplayFor(modelItem => item.VtdFullName)
                                </td>
                                <td class="align-middle">@Html.DisplayFor(modelItem => item.VtdEmail)</td>
                                <td class="align-middle">@Html.DisplayFor(modelItem => item.VtdPhone)</td>
                                <td class="align-middle text-center">
                                    <span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.VtdGender)</span>
                                </td>
                                <td class="align-middle">@Html.DisplayFor(modelItem => item.VtdBirthday)</td>
                                <td class="align-middle text-truncate" style="max-width: 150px;">
                                    @Html.DisplayFor(modelItem => item.VtdAddress)
                                </td>
                                <td class="align-middle text-center">
                                    <a asp-action="Details" asp-route-id="@item.VtdId" class="btn btn-sm btn-info" title="Chi tiết"><i class="fas fa-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@item.VtdId" class="btn btn-sm btn-warning" title="Sửa"><i class="fas fa-edit"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.VtdId" class="btn btn-sm btn-danger" title="Xóa"><i class="fas fa-trash"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card-footer clearfix">
                @Html.PagedListPager(Model, page => Url.Action("Index", new { page = page, name = ViewBag.keyword }), new X.PagedList.Web.Common.PagedListRenderOptions { LiElementClasses = new string[] { "page-item" }, PageClasses = new string[] { "page-link" }, UlElementClasses = new string[] { "pagination pagination-sm m-0 float-right" } })
            </div>
        </div>
    </div>
</section>