@model X.PagedList.IPagedList<K23CNT3_VuTienDuc_2310900023.Models.VtdBlog>
@using X.PagedList.Mvc.Core;

@{
    ViewData["Title"] = "Quản lý Blog";
}



<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="card card-outline card-success shadow">

            <!-- Card Header: Nút Thêm và Form tìm kiếm -->
            <div class="card-header">
                <h3 class="card-title">
                    <a asp-action="Create" class="btn btn-success btn-sm">
                        <i class="fas fa-plus"></i> Thêm Blog mới
                    </a>
                </h3>

                <div class="card-tools mt-1">
                    <form action="" method="get">
                        <div class="input-group input-group-sm" style="width: 300px;">
                            <input type="text" name="name" class="form-control float-right" placeholder="Nhập tên blog cần tìm..." value="@ViewBag.keyword">
                            <div class="input-group-append">
                                <button type="submit" class="btn btn-default">
                                    <i class="fas fa-search"></i>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Card Body: Bảng dữ liệu -->
            <div class="card-body table-responsive p-0">
                <table class="table table-hover table-striped text-nowrap align-middle">
                    <thead class="bg-light">
                        <tr>
                            <th class="text-center" style="width: 120px;">@Html.DisplayNameFor(model => model.FirstOrDefault().VtdImage)</th>
                            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().VtdName)</th>
                            <th class="text-center">@Html.DisplayNameFor(model => model.FirstOrDefault().VtdStatus)</th>
                            <th class="text-center">@Html.DisplayNameFor(model => model.FirstOrDefault().VtdViewCount)</th>
                            <th class="text-center">@Html.DisplayNameFor(model => model.FirstOrDefault().VtdCreatedDate)</th>
                            <th>@Html.DisplayNameFor(model => model.FirstOrDefault().VtdDescription)</th>
                            <th class="text-center" style="width: 150px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="align-middle text-center p-2">
                                    <img src="@item.VtdImage" alt="Blog Image" class="img-thumbnail" style="width: 100px; height: 70px; object-fit: cover;" />
                                </td>
                                <td class="align-middle fw-bold text-primary text-wrap" style="min-width: 200px;">
                                    @Html.DisplayFor(modelItem => item.VtdName)
                                </td>
                                <td class="align-middle text-center">
                                    @if (item.VtdStatus == 1)
                                    {
                                        <span class="badge bg-success">Đang xuất bản</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Bản nháp</span>
                                    }
                                </td>
                                <td class="align-middle text-center">
                                    <span class="badge bg-info">@item.VtdViewCount</span>
                                </td>
                                <td class="align-middle text-center">
                                    @(item.VtdCreatedDate.ToString("dd/MM/yyyy"))
                                </td>
                                <td class="align-middle text-truncate" style="max-width: 250px;">
                                    @Html.DisplayFor(modelItem => item.VtdDescription)
                                </td>
                                <td class="align-middle text-center">
                                    <a asp-action="Details" asp-route-id="@item.VtdId" class="btn btn-sm btn-info" title="Chi tiết">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.VtdId" class="btn btn-sm btn-warning" title="Sửa">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.VtdId" class="btn btn-sm btn-danger" title="Xóa">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Card Footer: Phân trang -->
            <div class="card-footer clearfix">
                @Html.PagedListPager(Model, page => Url.Action("Index", new { page = page, name = ViewBag.keyword }), new X.PagedList.Web.Common.PagedListRenderOptions
           {
               LiElementClasses = new string[] { "page-item" },
               PageClasses = new string[] { "page-link" },
               UlElementClasses = new string[] { "pagination pagination-sm m-0 float-right" }
           })
            </div>

        </div>
    </div>
</section>