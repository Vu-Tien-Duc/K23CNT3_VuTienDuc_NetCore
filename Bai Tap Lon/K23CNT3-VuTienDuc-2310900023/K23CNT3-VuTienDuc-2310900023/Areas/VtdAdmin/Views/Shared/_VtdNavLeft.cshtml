@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();

    string ActiveMenu(string controller)
    {
        return string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : "";
    }

    // Lấy thông tin người dùng từ Cookie
    var userName = User.Identity.IsAuthenticated ? User.Identity.Name : "Quản trị viên";
    var userAvatar = User.Claims.FirstOrDefault(c => c.Type == "Avatar")?.Value;

    // Nếu không có avatar trong database thì dùng ảnh mặc định
    if (string.IsNullOrEmpty(userAvatar))
    {
        userAvatar = "/images/accounts/admin-avatar.jpg";
    }
}

<aside class="main-sidebar sidebar-dark-primary elevation-4">
    <!-- Brand Logo (Logo ứng dụng) -->
    <a asp-area="VtdAdmin"
       asp-controller="VtdDashboard"
       asp-action="Index"
       class="brand-link">
        <!-- Bạn có thể đổi ảnh này thành Logo của công ty/website -->
        <img src="/dist/img/AdminLTELogo.png"
             alt="Product Store Logo"
             class="brand-image img-circle elevation-3"
             style="opacity: .8">
        <span class="brand-text font-weight-light">Product Store</span>
    </a>

    <!-- Sidebar -->
    <div class="sidebar">

        <!-- THÔNG TIN NGƯỜI DÙNG ĐĂNG NHẬP (USER PANEL) -->
        <div class="user-panel mt-3 pb-3 mb-3 d-flex align-items-center">
            <div class="image">
                <img src="@userAvatar" class="img-circle elevation-2" alt="User Image" style="width: 35px; height: 35px; object-fit: cover;">
            </div>
            <div class="info">
                <a href="#" class="d-block fw-bold">@userName</a>
            </div>
        </div>

        <!-- Sidebar Menu -->
        <nav class="mt-2">
            <ul class="nav nav-pills nav-sidebar flex-column"
                data-widget="treeview"
                role="menu"
                data-accordion="false">

                <li class="nav-item">
                    <a asp-area="VtdAdmin"
                       asp-controller="VtdDashboard"
                       asp-action="Index"
                       class="nav-link @ActiveMenu("VtdDashboard")">
                        <i class="nav-icon fas fa-tachometer-alt"></i>
                        <p>Dashboard</p>
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-area="VtdAdmin"
                       asp-controller="VtdProducts"
                       asp-action="Index"
                       class="nav-link @ActiveMenu("VtdProducts")">
                        <i class="nav-icon fas fa-box"></i>
                        <p>Products</p>
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-area="VtdAdmin"
                       asp-controller="VtdCategories"
                       asp-action="Index"
                       class="nav-link @ActiveMenu("VtdCategories")">
                        <i class="nav-icon fas fa-tags"></i>
                        <p>Category</p>
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-area="VtdAdmin"
                       asp-controller="VtdBanners"
                       asp-action="Index"
                       class="nav-link @ActiveMenu("VtdBanners")">
                        <i class="nav-icon fas fa-images"></i>
                        <p>Banners</p>
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-area="VtdAdmin"
                       asp-controller="VtdBlogs"
                       asp-action="Index"
                       class="nav-link @ActiveMenu("VtdBlogs")">
                        <i class="nav-icon fas fa-newspaper"></i>
                        <p>Blogs</p>
                    </a>
                </li>

                <li class="nav-header">MANAGEMENT</li>

                <li class="nav-item">
                    <a asp-area="VtdAdmin"
                       asp-controller="VtdCustomers"
                       asp-action="Index"
                       class="nav-link @ActiveMenu("VtdCustomers")">
                        <i class="nav-icon fas fa-users"></i>
                        <p>Customers</p>
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-area="VtdAdmin"
                       asp-controller="VtdOrders"
                       asp-action="Index"
                       class="nav-link @ActiveMenu("VtdOrders")">
                        <i class="nav-icon fas fa-shopping-cart"></i>
                        <p>Orders</p>
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-area="VtdAdmin"
                       asp-controller="VtdOrderDetails"
                       asp-action="Index"
                       class="nav-link @ActiveMenu("VtdOrderDetails")">
                        <i class="nav-icon fas fa-file-invoice-dollar"></i>
                        <p>Order Details</p>
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-area="VtdAdmin"
                       asp-controller="VtdAccounts"
                       asp-action="Index"
                       class="nav-link @ActiveMenu("VtdAccounts")">
                        <i class="nav-icon fas fa-user-shield"></i>
                        <p>Accounts</p>
                    </a>
                </li>

                <!-- Nút Đăng xuất ngay dưới menu (Tùy chọn) -->
                <li class="nav-item mt-3">
                    <a asp-area="VtdAdmin"
                       asp-controller="VtdAuth"
                       asp-action="Logout"
                       class="nav-link text-danger">
                        <i class="nav-icon fas fa-sign-out-alt"></i>
                        <p>Đăng xuất</p>
                    </a>
                </li>

            </ul>
        </nav>
    </div>
</aside>