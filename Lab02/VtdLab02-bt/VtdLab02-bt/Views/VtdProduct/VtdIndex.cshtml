@{
    ViewData["Title"] = "Danh sách điện thoại";
    var products = ViewBag.Products;
}

<div class="row">

    <!-- Danh mục bên trái -->
    <div class="col-md-3">

        <h3><b>DANH MỤC</b></h3>

        <div class="list-group">

            <a href="#" class="list-group-item list-group-item-action">
                iPhone
            </a>

            <a href="#" class="list-group-item list-group-item-action">
                Samsung
            </a>

            <a href="#" class="list-group-item list-group-item-action">
                Xiaomi
            </a>

            <a href="#" class="list-group-item list-group-item-action">
                OPPO
            </a>

            <a href="#" class="list-group-item list-group-item-action">
                Vivo
            </a>

            <a href="#" class="list-group-item list-group-item-action">
                Google Pixel
            </a>

        </div>

    </div>

    <!-- Danh sách sản phẩm -->
    <div class="col-md-9">

        <h2>Danh sách điện thoại</h2>

        <div class="row">

            @foreach (var item in products)
            {
                <div class="col-md-4">

                    <div class="card mb-4">

                        <img src="@item.Image"
                             class="card-img-top"
                             style="height:250px; object-fit:cover;" />

                        <div class="card-body">

                            <h5>@item.ProductName</h5>

                            <p>
                                <del>@item.OldPrice.ToString("N0") VNĐ</del>
                                <br />

                                <span class="text-danger fw-bold">
                                    @item.Price.ToString("N0") VNĐ
                                </span>
                            </p>

                            <a asp-controller="VtdProduct"
                               asp-action="VtdDetail"
                               asp-route-id="@item.Id"
                               class="btn btn-success w-100">
                                Chi tiết
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>

    </div>

</div>