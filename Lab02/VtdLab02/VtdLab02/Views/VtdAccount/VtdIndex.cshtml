@{
	ViewData["Title"] = "VtdIndex";
	var accounts = ViewBag.Accounts;
}
<div class="row">
@foreach (var item in accounts)
{
<div class="col-md-4">
<div class="thumbnail">
<img src="@item.Avatar" alt="">
<div class="caption">
<h3>@item.Name</h3>
<p>
@item.Bio
</p>
<p>


						<a asp-controller="VtdAccount"
						   asp-action="VtdProfile"
						   asp-route-id="@item.Id"
						   class="btn btn-primary">
							Profile
						</a>

</p>
</div>
			</div>
		</div>
	}
</div>