@model IEnumerable<VtdLab07bt2.Models.VtdCategory>

@{
    ViewData["Title"] = "Index Category";
}

<h1>Category Management</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Create New
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead class="thead-dark">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.VtdName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.VtdStatus)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.VtdCreatedDate)
            </th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.VtdName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.VtdStatus)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.VtdCreatedDate)
                </td>
                <td class="text-center">
                    <a asp-action="Edit" asp-route-id="@item.VtdId" class="btn btn-sm btn-warning">
                        <i class="fas fa-edit"></i> Edit
                    </a>
                    <a asp-action="Details" asp-route-id="@item.VtdId" class="btn btn-sm btn-info">
                        <i class="fas fa-eye"></i> Details
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.VtdId" class="btn btn-sm btn-danger">
                        <i class="fas fa-trash-alt"></i> Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>