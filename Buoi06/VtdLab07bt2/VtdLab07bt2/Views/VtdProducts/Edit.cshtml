@model VtdLab07bt2.Models.VtdProduct

@{
    ViewData["Title"] = "Edit Product";
}

<div class="card card-warning">
    <div class="card-header">
        <h3 class="card-title">Edit Product</h3>
    </div>

    <form asp-action="Edit" enctype="multipart/form-data">

        <div class="card-body">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input asp-for="VtdId" type="hidden" />

            <div class="form-group">
                <label asp-for="VtdName"></label>
                <input asp-for="VtdName" class="form-control" />
                <span asp-validation-for="VtdName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="VtdPrice"></label>
                <input asp-for="VtdPrice" class="form-control" />
                <span asp-validation-for="VtdPrice" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="VtdSalePrice"></label>
                <input asp-for="VtdSalePrice" class="form-control" />
                <span asp-validation-for="VtdSalePrice" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="VtdStatus"></label>
                <input asp-for="VtdStatus" class="form-control" />
                <span asp-validation-for="VtdStatus" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Category</label>
                <select asp-for="VtdCategoryId"
                        asp-items="ViewBag.VtdCategoryId"
                        class="form-control">
                </select>
            </div>

            <div class="form-group">
                <label asp-for="VtdCreatedDate"></label>
                <input asp-for="VtdCreatedDate"
                       type="date"
                       class="form-control" />
            </div>

            <div class="form-group">
                <label>Current Image</label>
                <br />

                @if (!string.IsNullOrEmpty(Model.VtdImage))
                {
                    <img src="~/images/product/@Model.VtdImage"
                         width="150"
                         class="img-thumbnail mb-2" />
                }
                else
                {
                    <p class="text-danger">No Image</p>
                }
            </div>

            <div class="form-group">
                <label>New Image</label>
                <!-- Sửa name="VtdImage" THÀNH name="ImageFile" -->
                <input type="file"
                       name="ImageFile"
                       class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="VtdDescription"></label>
                <textarea asp-for="VtdDescription"
                          rows="5"
                          class="form-control"></textarea>
            </div>

        </div>

        <div class="card-footer">
            <button type="submit" class="btn btn-warning">
                <i class="fas fa-save"></i> Update
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back
            </a>
        </div>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}