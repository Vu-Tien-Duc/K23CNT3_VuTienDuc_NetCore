@model IEnumerable<VtdLab07bt2.Models.VtdProduct>

@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div class="card card-primary card-outline">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-box-open"></i> Danh sách sản phẩm
        </h3>

        <div class="card-tools">
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="fas fa-plus"></i> Thêm sản phẩm
            </a>
        </div>
    </div>

    <div class="card-body">

        <table class="table table-bordered table-hover text-center">
            <thead class="table-primary">
                <tr>
                    <th>Ảnh</th>
                    <th>Tên sản phẩm</th>
                    <th>Giá</th>
                    <th>Giá KM</th>
                    <th>Trạng thái</th>
                    <th>Ngày tạo</th>
                    <th>Danh mục</th>
                    <th width="180">Thao tác</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td width="100">

                            @if (!string.IsNullOrEmpty(item.VtdImage))
                            {
                                <img src="~/images/product/@item.VtdImage"
                                     class="img-thumbnail"
                                     style="width:80px;height:80px;object-fit:cover;" />
                            }
                            else
                            {
                                <img src="~/images/no-image.png"
                                     class="img-thumbnail"
                                     style="width:80px;height:80px;" />
                            }

                        </td>

                        <td class="text-left">
                            @item.VtdName
                        </td>

                        <td>
                            @item.VtdPrice.ToString("N0")
                        </td>

                        <td>
                            @Html.DisplayFor(modelItem => item.VtdPrice)
                        </td>

                        <td>

                            @if (item.VtdStatus == 1)
                            {
                                <span class="badge bg-success">
                                    Hiển thị
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Ẩn
                                </span>
                            }

                        </td>

                        <td>
                            @string.Format("{0:dd/MM/yyyy}", item.VtdCreatedDate)
                        </td>

                        <td>
                            @item.VtdCategory?.VtdName
                        </td>

                        <td>

                            <a asp-action="Edit"
                               asp-route-id="@item.VtdId"
                               class="btn btn-warning btn-sm">

                                <i class="fas fa-edit"></i>

                            </a>

                            <a asp-action="Details"
                               asp-route-id="@item.VtdId"
                               class="btn btn-info btn-sm">

                                <i class="fas fa-eye"></i>

                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.VtdId"
                               class="btn btn-danger btn-sm">

                                <i class="fas fa-trash"></i>

                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>