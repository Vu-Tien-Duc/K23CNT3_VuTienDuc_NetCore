@model VtdLab07.Models.VtdAccount
@{
    ViewData["Title"] = "Sửa tài khoản";
}

<div class="mb-4">
    <h2 class="fw-bold mb-1"><i class="bi bi-person-gear me-2 text-primary"></i>Sửa tài khoản</h2>
    <p class="text-muted mb-0">Cập nhật thông tin tài khoản</p>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
            <input type="hidden" asp-for="VtdAccountId" />

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="VtdUsername" class="form-label fw-semibold"></label>
                    <input asp-for="VtdUsername" class="form-control" />
                    <span asp-validation-for="VtdUsername" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="VtdPassword" class="form-label fw-semibold"></label>
                    <input asp-for="VtdPassword" type="password" class="form-control" />
                    <span asp-validation-for="VtdPassword" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="VtdFullName" class="form-label fw-semibold"></label>
                    <input asp-for="VtdFullName" class="form-control" />
                    <span asp-validation-for="VtdFullName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="VtdEmail" class="form-label fw-semibold"></label>
                    <input asp-for="VtdEmail" type="email" class="form-control" />
                    <span asp-validation-for="VtdEmail" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="VtdPhone" class="form-label fw-semibold"></label>
                    <input asp-for="VtdPhone" class="form-control" />
                    <span asp-validation-for="VtdPhone" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="VtdAddress" class="form-label fw-semibold"></label>
                    <input asp-for="VtdAddress" class="form-control" />
                    <span asp-validation-for="VtdAddress" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold"><i class="bi bi-image me-1"></i>Ảnh đại diện</label>
                    @if (!string.IsNullOrEmpty(Model.VtdPicture))
                    {
                        var avatarSrc = (Model.VtdPicture.StartsWith("http") || Model.VtdPicture.StartsWith("/"))
                        ? Model.VtdPicture
                        : Url.Content("~/images/account/" + Model.VtdPicture);
                        <div class="mb-2">
                            <img src="@avatarSrc" alt="@Model.VtdUsername" class="rounded-circle" style="width:64px;height:64px;object-fit:cover;" />
                            <span class="text-muted small ms-2">Ảnh hiện tại</span>
                        </div>
                    }
                    <input type="file" name="anhDaiDien" class="form-control" accept="image/*" />
                    <div class="form-text">Chỉ chọn ảnh nếu muốn thay ảnh mới, để trống nếu giữ ảnh cũ.</div>
                </div>

                <div class="col-md-3 d-flex align-items-center">
                    <div class="form-check form-switch mt-4">

                        <input type="checkbox"
                               class="form-check-input"
                               id="VtdIsAdmin"
                               name="VtdIsAdmin"
                               value="true"
                        @(Model != null && Model.VtdIsAdmin == true ? "checked" : "") />

                        <input type="hidden" name="VtdIsAdmin" value="false" />

                        <label for="VtdIsAdmin" class="form-check-label fw-semibold">
                            Quản trị
                        </label>

                    </div>
                </div>

                <div class="col-md-3 d-flex align-items-center">
                    <div class="form-check form-switch mt-4">

                        <input type="checkbox"
                               class="form-check-input"
                               id="VtdActive"
                               name="VtdActive"
                               value="true"
                        @(Model != null && Model.VtdActive == true ? "checked" : "") />

                        <input type="hidden" name="VtdActive" value="false" />

                        <label for="VtdActive" class="form-check-label fw-semibold">
                            Hoạt động
                        </label>

                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-check-circle me-1"></i> Lưu thay đổi
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
