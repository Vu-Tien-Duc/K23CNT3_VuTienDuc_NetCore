@model VtdLab07.Models.VtdCategory
@{
    ViewData["Title"] = "Sửa thể loại";
}

<div class="mb-4">
    <h2 class="fw-bold mb-1"><i class="bi bi-tag me-2 text-primary"></i>Sửa thể loại</h2>
    <p class="text-muted mb-0">Cập nhật tên thể loại sách</p>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                    <input type="hidden" asp-for="VtdCategoryId" />

                    <div class="mb-3">
                        <label asp-for="VtdCategoryName" class="form-label fw-semibold"></label>
                        <input asp-for="VtdCategoryName" class="form-control" />
                        <span asp-validation-for="VtdCategoryName" class="text-danger small"></span>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-circle me-1"></i> Lưu thay đổi
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
