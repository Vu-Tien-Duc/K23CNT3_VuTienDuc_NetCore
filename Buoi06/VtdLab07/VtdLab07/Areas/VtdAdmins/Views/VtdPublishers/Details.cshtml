@model VtdLab07.Models.VtdPublisher
@{
    ViewData["Title"] = "Chi tiết nhà xuất bản";
}

<div class="mb-4">
    <h2 class="fw-bold mb-1"><i class="bi bi-building me-2 text-primary"></i>Chi tiết nhà xuất bản</h2>
    <p class="text-muted mb-0">Thông tin nhà xuất bản</p>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted fw-normal">@Html.DisplayNameFor(model => model.VtdPublisherName)</dt>
                    <dd class="col-sm-8 fw-semibold">@Html.DisplayFor(model => model.VtdPublisherName)</dd>

                    <dt class="col-sm-4 text-muted fw-normal"><i class="bi bi-telephone me-1"></i>@Html.DisplayNameFor(model => model.VtdPhone)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.VtdPhone)</dd>

                    <dt class="col-sm-4 text-muted fw-normal"><i class="bi bi-geo-alt me-1"></i>@Html.DisplayNameFor(model => model.VtdAddress)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.VtdAddress)</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="mt-3 d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model?.VtdPublisherId" class="btn btn-warning">
        <i class="bi bi-pencil me-1"></i> Sửa
    </a>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
    </a>
</div>
