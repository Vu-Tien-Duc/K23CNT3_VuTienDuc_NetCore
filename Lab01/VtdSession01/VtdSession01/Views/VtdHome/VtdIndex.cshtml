                <div class="card-body border-top">
                    <h5 class="card-title text-muted">Product Name 2</h5>
                </div>
            </div>
        </div>

        <!-- Sản phẩm 3 -->
        <div class="col-md-3 col-sm-6 mb-4">
            <div class="card h-100 border-light shadow-sm text-center">
                <img src="~/images/product3.jpg" class="card-img-top p-3" alt="Product 3" style="height: 200px; object-fit: contain;">
                <div class="card-body border-top">
                    <h5 class="card-title text-muted">Product Name 3</h5>
                </div>
            </div>
        </div>

        <!-- Sản phẩm 4 -->
        <div class="col-md-3 col-sm-6 mb-4">
            <div class="card h-100 border-light shadow-sm text-center">
                <img src="~/images/product4.jpg" class="card-img-top p-3" alt="Product 4" style="height: 200px; object-fit: contain;">
                <div class="card-body border-top">
                    <h5 class="card-title text-muted">Product Name 4</h5>
                </div>
            </div>
        </div>

    </div>
</div>