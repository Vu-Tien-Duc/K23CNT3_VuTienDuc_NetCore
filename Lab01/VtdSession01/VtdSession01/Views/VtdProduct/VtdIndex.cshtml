@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div class="container mt-4">
    <!-- Tiêu đề trang -->
    <h2 class="mb-4" style="font-weight: 400; color: #333;">@ViewData["Title"]</h2>

    <!-- Bảng danh sách sản phẩm -->
    <table class="table" style="vertical-align: middle;">
        <thead>
            <tr style="border-bottom: 2px solid #e0e0e0;">
                <th scope="col" class="border-0">ID</th>
                <th scope="col" class="border-0">Name</th>
                <th scope="col" class="border-0">Price</th>
                <th scope="col" class="border-0">Created At</th>
                <th scope="col" class="border-0">Image</th>
                <th scope="col" class="border-0">Actions</th>
            </tr>
        </thead>
        <tbody>
            <!-- Sản phẩm 1 -->
            <tr style="border-bottom: 1px solid #e0e0e0;">
                <td>1</td>
                <td>iPhone 15 Pro Max 256GB</td>
                <td>29,990,000 đ</td>
                <td>20-04-2024</td>
                <td>
                    <img src="~/images/product1.jpg" alt="iPhone 15 Pro Max" style="height: 45px; object-fit: contain;" />
                </td>
                <td>
                    <a asp-controller="VtdProduct" asp-action="VtdDetails" class="btn btn-success btn-sm px-3 shadow-sm">View</a>
                </td>
            </tr>

            <!-- Sản phẩm 2 -->
            <tr style="border-bottom: 1px solid #e0e0e0;">
                <td>2</td>
                <td>Samsung Galaxy S24 Ultra</td>
                <td>31,990,000 đ</td>
                <td>22-04-2024</td>
                <td>
                    <img src="~/images/product2.jpg" alt="Galaxy S24 Ultra" style="height: 45px; object-fit: contain;" />
                </td>
                <td>
                    <a asp-controller="VtdProduct" asp-action="VtdDetails" class="btn btn-success btn-sm px-3 shadow-sm">View</a>
                </td>
            </tr>

            <!-- Sản phẩm 3 -->
            <tr style="border-bottom: 1px solid #e0e0e0;">
                <td>3</td>
                <td>Xiaomi 14 Pro 5G</td>
                <td>19,500,000 đ</td>
                <td>25-04-2024</td>
                <td>
                    <img src="~/images/product3.jpg" alt="Xiaomi 14 Pro" style="height: 45px; object-fit: contain;" />
                </td>
                <td>
                    <a asp-controller="VtdProduct" asp-action="VtdDetails" class="btn btn-success btn-sm px-3 shadow-sm">View</a>
                </td>
            </tr>

            <!-- Sản phẩm 4 -->
            <tr style="border-bottom: 1px solid #e0e0e0;">
                <td>4</td>
                <td>Oppo Find X7 Ultra</td>
                <td>21,000,000 đ</td>
                <td>26-04-2024</td>
                <td>
                    <img src="~/images/product4.jpg" alt="Oppo Find X7 Ultra" style="height: 45px; object-fit: contain;" />
                </td>
                <td>
                    <a asp-controller="VtdProduct" asp-action="VtdDetails" class="btn btn-success btn-sm px-3 shadow-sm">View</a>
                </td>
            </tr>
        </tbody>
    </table>
</div>